# EditorConfig: https://editorconfig.org
# Mirrors .prettierrc.json (prettier defaults: 2 spaces, LF) and src-tauri/rustfmt.toml
# (rustfmt defaults: 4 spaces). Prettier and rustfmt remain the authority.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,rs,java,gradle,kts}]
indent_size = 4

[*.md]
# A trailing double space is a hard line break in Markdown.
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf

[{package-lock.json,**/*-sources.json}]
# Generated by tools; never reformat by hand.
insert_final_newline = unset
trim_trailing_whitespace = unset
