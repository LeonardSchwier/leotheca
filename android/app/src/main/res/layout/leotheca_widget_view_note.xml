<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_view_note"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="#F4F1EC">
    <TextView
        android:id="@+id/widget_view_note_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end"
        android:textStyle="bold"
        android:textSize="16sp"
        android:text="Leotheca" />
    <TextView
        android:id="@+id/widget_view_note_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:maxLines="6"
        android:ellipsize="end"
        android:textSize="13sp"
        android:text="Tap to view this note." />
    <TextView
        android:id="@+id/widget_view_note_change_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="#8A8A8A"
        android:text="Tap to open / change note" />
</LinearLayout>
