{
  "manifest_version": 3,
  "name": "Leotheca Web Clipper",
  "version": "0.1.0",
  "description": "Save a selected page excerpt as an ordinary Markdown file.",
  "permissions": ["activeTab", "downloads"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clip selection",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["clipperCore.js", "content.js"]
    }
  ],
  "commands": {
    "clip-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+L"
      },
      "description": "Clip the current selection"
    }
  }
}
