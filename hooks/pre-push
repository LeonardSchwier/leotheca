#!/usr/bin/env bash
# Pre-push gate. Fast by default (about a minute): rule checks over the pushed
# commits, then scripts/verify-fast.sh. A gate that takes tens of minutes gets
# bypassed with --no-verify, which protects nothing, so the slow full pipeline
# is explicit:  PREPUSH_FULL=1 git push   or   npm run ci
#
# Pushes that only touch the roadmap or files under .agents skip the application
# checks (they cannot affect the app); commit message rules still run.
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1

ZERO=0000000000000000000000000000000000000000
METADATA_RE='^(ROADMAP\.md|\.agents/.*)$'
failed=0
app_changed=0
checked=0

# Snapshot before anything runs: a test or script run by this gate must not
# change HEAD or the local git identity (git exports GIT_DIR into hooks, and a
# test that ran git without clearing it once emptied main). Checked at the end.
head_before="$(git rev-parse HEAD 2>/dev/null || true)"
user_before="$(git config --local --get user.name 2>/dev/null || true)"

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  if [ "$local_sha" = "$ZERO" ]; then # branch deletion
    case "$remote_ref" in
      refs/heads/main | refs/heads/master)
        echo "pre-push: BLOCKED deleting $remote_ref" >&2
        failed=1
        ;;
    esac
    continue
  fi
  checked=1

  # Main changes only through a merged pull request (skills/pull-request-delivery.md).
  case "$remote_ref" in
    refs/heads/main | refs/heads/master)
      echo "pre-push: BLOCKED direct push to $remote_ref. Push your work branch and open a pull request with auto-merge." >&2
      failed=1
      continue
      ;;
  esac

  base="$remote_sha"
  if [ "$base" = "$ZERO" ] || ! git cat-file -e "$base^{commit}" 2>/dev/null; then
    # New branch: compare against main, falling back to the tip commit alone.
    base="$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "$local_sha~1")"
  fi

  # Force push / history rewrite: the remote tip must be an ancestor of what we send.
  if [ "$remote_sha" != "$ZERO" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null \
    && ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
    echo "pre-push: BLOCKED non-fast-forward update of $remote_ref (force push). Fetch, merge, retest, push normally." >&2
    failed=1
    continue
  fi

  echo "pre-push: rule checks for $base..$local_sha"
  node scripts/check-rules.mjs commits "$base" "$local_sha" || failed=1
  node scripts/check-rules.mjs lines "$base" "$local_sha" || failed=1
  node scripts/check-rules.mjs format "$base" "$local_sha" || failed=1
  node scripts/check-rules.mjs deps "$base" "$local_sha" || failed=1
  node scripts/check-rules.mjs trailers "$base" "$local_sha" || failed=1
  node scripts/check-rules.mjs reflection "$base" "$local_sha" || failed=1
  node scripts/check-rules.mjs glossary "$base" "$local_sha" || failed=1

  # The ledger branch is main plus roadmap and handoff files. Merging main into it
  # (needed before a finish) must not look like an application change, so judge
  # it by what it adds on top of main.
  app_base="$base"
  ledger_ref="refs/heads/$(grep -o '"ledger_branch": "[^"]*"' CONSTITUTION.md | sed 's/.*: "//;s/"$//')"
  if [ "$remote_ref" = "$ledger_ref" ]; then
    mb="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
    [ -n "$mb" ] && app_base="$mb"
  fi
  if git diff --name-only "$app_base" "$local_sha" | grep -v -E "$METADATA_RE" | grep -q .; then
    app_changed=1
  fi
done

if [ "$failed" -ne 0 ]; then
  echo "pre-push: rule checks FAILED. Fix the items above, then push again." >&2
  exit 1
fi

[ "$checked" -eq 0 ] && exit 0

if [ "$app_changed" -eq 0 ]; then
  echo "pre-push: metadata-only push (roadmap/handoffs), application checks skipped."
  exit 0
fi

if [ "${PREPUSH_FULL:-0}" = "1" ]; then
  echo "pre-push: PREPUSH_FULL=1, running the full pipeline (slow)"
  bash scripts/ci-local.sh || { echo "pre-push: full pipeline FAILED" >&2; exit 1; }
else
  bash scripts/verify-fast.sh || {
    echo "pre-push: verification FAILED. Fix the errors above and push again." >&2
    echo "          Full pipeline: PREPUSH_FULL=1 git push" >&2
    exit 1
  }
fi

head_after="$(git rev-parse HEAD 2>/dev/null || true)"
user_after="$(git config --local --get user.name 2>/dev/null || true)"
if [ "$head_after" != "$head_before" ] || [ "$user_after" != "$user_before" ]; then
  echo "pre-push: the checks changed the repository (HEAD $head_before -> $head_after, user.name [$user_before] -> [$user_after]); a test is not isolated. Refusing to push." >&2
  exit 1
fi
