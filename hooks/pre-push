#!/usr/bin/env bash
# Pre-push verification gate: runs the full local CI/CD pipeline before allowing a push.
#
# This hook runs on EVERY push and covers:
#   - Frontend: type check, lint, version consistency, tests, build
#   - Backend (Rust/Tauri): fmt, clippy, tests
#   - Android: unit tests, debug APK build (if SDK available)
#   - AppImage: tauri build (if available)
#   - Flatpak: manifest lint + build (if flatpak-builder available)
#
# Quick mode (skips slow builds): set CI_LOCAL_QUICK=1
#   CI_LOCAL_QUICK=1 git push
#
# Skip specific checks:
#   CI_LOCAL_SKIP_ANDROID=1   CI_LOCAL_SKIP_APPIMAGE=1   CI_LOCAL_SKIP_FLATPAK=1
#
# Emergency bypass: git push --no-verify

set -o pipefail

# Resolve repo root from the git directory (works regardless of how this
# script is invoked — symlink, direct path, or relative path).
GIT_DIR="$(cd "$(dirname "$0")" && git rev-parse --git-dir 2>/dev/null)"
if [ -n "$GIT_DIR" ]; then
  REPO_ROOT="$(cd "$GIT_DIR" && cd .. && pwd)"
else
  # Fallback: walk up from the script location
  REPO_ROOT="$(cd "$(dirname "$0")" && git rev-parse --show-toplevel 2>/dev/null)"
  if [ -z "$REPO_ROOT" ]; then
    REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
  fi
fi
cd "$REPO_ROOT"

echo ""
echo "═══ Pre-push: running full local CI/CD pipeline ═══"
echo ""

# Run the full CI suite (all checks, not --quick)
if bash scripts/ci-local.sh; then
  echo ""
  echo "✅ Pre-push CI passed. Pushing..."
else
  echo ""
  echo "❌ Pre-push CI FAILED. Fix the errors above and push again."
  echo "   Quick mode (skip slow builds): CI_LOCAL_QUICK=1 git push"
  echo "   Emergency bypass: git push --no-verify"
  exit 1
fi
